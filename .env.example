# Public deployment options. Keep the existing values when adding new fields to .env.
# Defaults below are non-secret; real credentials belong only in the ignored .env.
# Set true to use the Agent with the configured provider; default is offline.
# No project-wide usage counter. Per-task budgets and replay receipts remain.
# App settings: restart dev.py in development; recreate api/worker in production.
# No image rebuild is needed for app-only changes. Ports/mounts still need Compose.
# Explicit process overrides win (e.g. MODEL_CALLS_ENABLED=false for offline tests).
MODEL_CALLS_ENABLED=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
AGENT_MODEL=deepseek-flash
MODEL_TIMEOUT_SECONDS=45
# Current adapter is DeepSeek Chat Completions. A different model/endpoint must
# also match config/model-capacity.json; changing a name is not protocol validation.

# Generate a local password before first Compose startup. Never commit .env.
POSTGRES_PASSWORD=
KNOWLEDGEOPS_PORT=8787
# HTTP hosts accepted by the API. This is not authentication or public deployment.
API_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Shared API/worker log level: critical, error, warning, info or debug.
APP_LOG_LEVEL=info
# Windows bind mounts may need polling for API/Vite hot reload. Native Linux can use false.
DEV_WATCH_POLLING=true
# Development dev.py generates database/Celery/test connections from this file;
# production Compose injects connections. Existing PG passwords need DB changes too.
# Dedicated host folder; never point this at the personal knowledge base.
AGENT_WORKSPACE_HOST=./data/agent-workspace
# Internal paths are set by Compose (production) or dev.py (development):
# /data/agent-workspace and its uploads/originals subdirectory. Configure the HOST
# directory above; changing internal paths also requires mount/backup adaptations.
# The retired KNOWLEDGE_BASE_ROOT is not read by this application.
# Local worker command timeout (1..300 seconds); cancellation is checked while running.
# This is not a security-isolated container; background services are not retained.
WORKSPACE_EXECUTE_TIMEOUT=60

# Host directories mounted read-only into both API and worker.
CONFIG_HOST_DIRECTORY=./config
SKILLS_HOST_DIRECTORY=./skills
# Optional paths INSIDE containers, if a custom mount layout is used.
# KNOWLEDGE_POLICY_PATH=/workspace/config/knowledge-policy.md
# MODEL_CAPACITY_PATH=/workspace/config/model-capacity.json
# WEB_SEARCH_CONFIG_PATH=/workspace/config/web-search.yaml
# SKILLS_DIRECTORY=/workspace/skills

# Optional runtime acceleration; durable events and checkpoints remain in PostgreSQL.
# Redis DB 0 is reserved for Celery. No public Redis port is required.
RUNTIME_REDIS_URL=redis://redis:6379/1
REDIS_EVENTS_ENABLED=true
REDIS_CHECKPOINT_CACHE_ENABLED=true
REDIS_EVENT_MAX_ENTRIES=1024
REDIS_EVENT_TTL_SECONDS=3600
REDIS_CHECKPOINT_TTL_SECONDS=900
REDIS_CHECKPOINT_MAX_ENTRIES=128
REDIS_CHECKPOINT_MAX_VALUE_BYTES=2097152
